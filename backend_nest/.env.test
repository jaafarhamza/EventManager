# Application
NODE_ENV=test
PORT=3000

# Database - Use separate test database
DATABASE_URL=mongodb://admin:admin123@localhost:27017/eventmanager_test?authSource=admin

# JWT Configuration
JWT_SECRET=test-secret-key-for-e2e-tests-min-32-characters-long-for-access-token
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=test-refresh-secret-key-for-e2e-tests-min-32-characters-long-for-refresh
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_EXPIRATION_DAYS=7

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Google OAuth (disabled for tests)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email Configuration (disabled for tests)
EMAIL_HOST=smtp.test.com
EMAIL_PORT=587
EMAIL_USER=test@test.com
EMAIL_PASSWORD=test-password
EMAIL_FROM=test@test.com

# Frontend URL
FRONTEND_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3001

# API Configuration
API_PREFIX=api

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=eventmanager_test
